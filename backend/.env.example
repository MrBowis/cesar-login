# Variables de entorno para la aplicación
# Copiar este archivo a .env y ajustar valores

# Base de datos
DATABASE_URL=postgresql://admin:admin@localhost:5432/db_login

# JWT
JWT_SECRET_KEY=change-this-secret-key-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=Secure Login API
DEBUG=False

# TOTP
TOTP_ISSUER=SecureLoginApp
TOTP_INTERVAL=30
TOTP_DIGITS=6

# AES-256 Encryption (para cifrar secretos TOTP en la base de datos)
AES_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-key-in-production-must-be-kept-secret
